# .env.example
# Copy to .env and fill in values. Never commit .env.

# ── GCP ──────────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET=insurance-graph-rag

# ── Neo4j (AuraDB Free) ───────────────────────────────────────────────────────
# Get these from console.neo4j.io after creating a free instance.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Get these from console.upstash.com after creating a free Redis database.
UPSTASH_REDIS_URL=rediss://default:token@your-endpoint.upstash.io:6379
UPSTASH_REDIS_TOKEN=

# ── Streamlit App ─────────────────────────────────────────────────────────────
# Shared password shown to interviewers. Set in Streamlit Cloud secrets too.
APP_PASSWORD=

# ── Local dev only ────────────────────────────────────────────────────────────
# Set to "local" to use source_file paths instead of GCS source_url.
STORAGE_MODE=local
